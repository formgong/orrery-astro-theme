{
  // For the "Deploy to Cloudflare" button: serves dist/ and puts the access key into the form (see worker.js).
  "name": "orrery",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" }
}
