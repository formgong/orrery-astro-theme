# Your Formgong access key (fk_…). Create a free form at https://formgong.com/new
# The key is public by design: it only allows sending submissions to your form.
PUBLIC_FORMGONG_ACCESS_KEY=fk_your_access_key

# Optional: any form backend that accepts a standard POST. Defaults to https://formgong.com/submit
# PUBLIC_FORMGONG_ENDPOINT=https://formgong.com/submit
