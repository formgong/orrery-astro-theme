---
/**
 * 9. The small looping line drawing on each service card. Each one shows what the service does:
 *   grid      data audit: a scanner passes over a table and flags the bad cells
 *   bars      reporting: a handful of numbers rising and falling against a target line
 *   forecast  forecasting: history is drawn, then the forecast and its range
 *   curve     pricing: a price slides along the profit curve to its peak
 *   bells     experiments: variant B's distribution separates from A's
 *   clusters  customer analysis: scattered customers settle into segments
 * Strokes use currentColor (the dark text on the accent card). Static under reduced motion.
 */
interface Props {
  kind: "grid" | "bars" | "forecast" | "curve" | "bells" | "clusters";
  class?: string;
}
const { kind, class: className } = Astro.props;

const gauss = (c: number, h: number) =>
  Array.from({ length: 45 }, (_, k) => {
    const x = 10 + k * 5;
    return `${k ? "L" : "M"}${x},${(96 - h * Math.exp(-(((x - c) / 26) ** 2))).toFixed(1)}`;
  }).join("");

let seed = 5;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const centers = [
  [52, 40],
  [122, 74],
  [194, 38],
];
const dots = Array.from({ length: 18 }, (_, i) => {
  const [cx, cy] = centers[i % 3];
  const x = cx + (rnd() - 0.5) * 26;
  const y = cy + (rnd() - 0.5) * 22;
  return { x, y, dx: 14 + rnd() * 212 - x, dy: 12 + rnd() * 84 - y, d: (rnd() * 0.6).toFixed(2) };
});
const bars = [0.55, 0.8, 0.4, 0.95, 0.65, 0.75, 0.5, 0.85];
const flags = [
  [2, 1],
  [5, 3],
  [8, 0],
  [10, 2],
];
---

<svg
  viewBox="0 0 240 110"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["art", `art-${kind}`, className]}
>
  {
    kind === "grid" && (
      <g>
        {Array.from({ length: 48 }, (_, k) => (
          <rect x={6 + (k % 12) * 19} y={14 + Math.floor(k / 12) * 19} width="19" height="19" stroke-width="1" />
        ))}
        {flags.map(([c, r]) => (
          <rect class="flag" x={6 + c * 19} y={14 + r * 19} width="19" height="19" fill="currentColor" style={`--d:${(c / 12) * 4}s`} />
        ))}
        <line class="scan" x1="6" y1="6" x2="6" y2="98" stroke-width="2" />
      </g>
    )
  }
  {
    kind === "bars" && (
      <g>
        <line x1="6" y1="98" x2="234" y2="98" />
        <line x1="6" y1="34" x2="234" y2="34" stroke-width="1" stroke-dasharray="3 5" />
        {bars.map((h, i) => (
          <rect
            class="bar"
            x={14 + i * 28}
            y={98 - 80}
            width="16"
            height="80"
            stroke-width="1.5"
            vector-effect="non-scaling-stroke"
            style={`--a:${h};--b:${(1.35 - h).toFixed(2)};--d:${(i * -0.37).toFixed(2)}s`}
          />
        ))}
      </g>
    )
  }
  {
    kind === "forecast" && (
      <g>
        <line x1="6" y1="100" x2="234" y2="100" stroke-width="1" />
        <path class="history" pathLength="1" d="M8 78L24 70 38 76 54 58 68 64 84 50 98 56 114 42 128 48" />
        <path class="band" d="M128 48L234 10M128 48L234 70" stroke-width="1" />
        <path class="ahead" d="M128 48L150 42 172 44 194 34 216 36 234 28" stroke-dasharray="4 5" />
        <circle class="now" cx="128" cy="48" r="3.5" fill="currentColor" />
      </g>
    )
  }
  {
    kind === "curve" && (
      <g>
        <line x1="6" y1="100" x2="234" y2="100" stroke-width="1" />
        <path d="M10 96Q120 -52 230 96" />
        <line x1="120" y1="22" x2="120" y2="100" stroke-width="1" stroke-dasharray="3 5" />
        <g class="slide-x">
          <circle class="slide-y" cx="10" cy="96" r="5" fill="currentColor" />
        </g>
      </g>
    )
  }
  {
    kind === "bells" && (
      <g>
        <line x1="6" y1="98" x2="234" y2="98" stroke-width="1" />
        <path d={gauss(92, 70)} />
        <line x1="92" y1="26" x2="92" y2="98" stroke-width="1" stroke-dasharray="3 5" />
        <g class="shift">
          <path d={gauss(128, 62)} stroke-width="2" />
          <line x1="128" y1="34" x2="128" y2="98" stroke-width="1" stroke-dasharray="3 5" />
        </g>
      </g>
    )
  }
  {
    kind === "clusters" && (
      <g>
        {centers.map(([x, y]) => (
          <circle class="ring" cx={x} cy={y} r="22" stroke-width="1" stroke-dasharray="3 4" />
        ))}
        {dots.map((p) => (
          <circle
            class="dot"
            cx={p.x.toFixed(1)}
            cy={p.y.toFixed(1)}
            r="3"
            fill="currentColor"
            stroke="none"
            style={`--dx:${p.dx.toFixed(1)}px;--dy:${p.dy.toFixed(1)}px;--d:${p.d}s`}
          />
        ))}
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    overflow: visible;
  }
  .bar,
  .slide-x,
  .slide-y,
  .shift,
  .dot,
  .scan {
    transform-box: fill-box;
  }
  .bar {
    transform-origin: 50% 100%;
    transform: scaleY(var(--a));
  }

  @media (prefers-reduced-motion: no-preference) {
    .scan {
      animation: scan 4s linear infinite;
    }
    .flag {
      animation: flag 4s linear infinite;
      animation-delay: var(--d);
    }
    .bar {
      animation: bar 2.6s var(--ease-in-out) infinite alternate;
      animation-delay: var(--d);
    }
    .history {
      stroke-dasharray: 1 1;
      animation: history 6s var(--ease-out) infinite;
    }
    .ahead,
    .band,
    .now {
      animation: ahead 6s ease infinite;
    }
    .band {
      animation-name: band;
    }
    .slide-x {
      animation: slide-x 3.2s linear infinite alternate;
    }
    .slide-y {
      animation: slide-y 3.2s linear infinite alternate;
    }
    .shift {
      animation: shift 3s var(--ease-in-out) infinite alternate;
    }
    .dot {
      animation: clump 6s var(--ease-in-out) infinite;
      animation-delay: var(--d);
    }
    .ring {
      animation: ring 6s ease infinite;
    }
  }

  @keyframes scan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(228px);
    }
  }
  @keyframes flag {
    0%,
    6% {
      fill-opacity: 0;
    }
    8%,
    70% {
      fill-opacity: 1;
    }
    80%,
    100% {
      fill-opacity: 0;
    }
  }
  @keyframes bar {
    from {
      transform: scaleY(var(--a));
    }
    to {
      transform: scaleY(var(--b));
    }
  }
  @keyframes history {
    0% {
      stroke-dashoffset: 1;
    }
    35%,
    92% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes ahead {
    0%,
    35% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes band {
    0%,
    50% {
      opacity: 0;
    }
    65%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes slide-x {
    to {
      transform: translateX(220px);
    }
  }
  @keyframes slide-y {
    0% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.333, 0.667, 0.667, 1);
    }
    50% {
      transform: translateY(-74px);
      animation-timing-function: cubic-bezier(0.333, 0, 0.667, 0.333);
    }
    100% {
      transform: translateY(0);
    }
  }
  @keyframes shift {
    from {
      transform: translateX(-28px);
    }
    to {
      transform: translateX(14px);
    }
  }
  @keyframes clump {
    0%,
    12% {
      transform: translate(var(--dx), var(--dy));
    }
    48%,
    84% {
      transform: none;
    }
    100% {
      transform: translate(var(--dx), var(--dy));
    }
  }
  @keyframes ring {
    0%,
    40% {
      opacity: 0;
    }
    55%,
    82% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }
</style>
