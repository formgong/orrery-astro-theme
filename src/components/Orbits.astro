---
/**
 * 6, 11. Line-art orbits: thin rings with small planets, one ring dashed. Every ring turns
 * around its own centre at its own speed (so the planets travel), and the whole drawing turns
 * very slowly. Pure SVG + CSS (".orbit-ring", ".orbits-turn" in effects.css); still under
 * reduced motion.
 *
 * variant="nested": rings of growing size that touch at one point (next to the statement).
 * variant="rings":  three near-concentric rings (beside the process panel).
 */
interface Props {
  variant?: "nested" | "rings";
  class?: string;
}
const { variant = "nested", class: className } = Astro.props;

type Ring = { cx: number; cy: number; r: number; dashed?: boolean; dot?: number; dur: number; reverse?: boolean };
const rings: Ring[] =
  variant === "nested"
    ? [60, 88, 116, 144, 172].map((r, i) => ({
        cx: 92 + r * 0.766,
        cy: 302 - r * 0.643,
        r,
        dashed: i === 4,
        dot: [200, 35, 130, 290, 70][i],
        dur: 34 + i * 13,
        reverse: i % 2 === 1,
      }))
    : [
        { cx: 200, cy: 204, r: 150, dot: 250, dur: 70 },
        { cx: 205, cy: 198, r: 156, dur: 90, reverse: true },
        { cx: 210, cy: 196, r: 162, dashed: true, dot: 110, dur: 120 },
      ];
const rad = (deg: number) => (deg * Math.PI) / 180;
---

<svg viewBox="0 0 400 400" fill="none" aria-hidden="true" class:list={["orbits", className]}>
  <g class="orbits-turn" style="transform-origin: 200px 200px; transform-box: view-box">
    {
      rings.map((ring) => (
        <g
          class="orbit-ring"
          style={`transform-origin:${ring.cx.toFixed(1)}px ${ring.cy.toFixed(1)}px;transform-box:view-box;--dur:${ring.dur}s;--dir:${ring.reverse ? "reverse" : "normal"}`}
        >
          <circle
            cx={ring.cx.toFixed(1)}
            cy={ring.cy.toFixed(1)}
            r={ring.r}
            stroke="currentColor"
            stroke-width="1.4"
            stroke-dasharray={ring.dashed ? "2 5" : undefined}
          />
          {ring.dot !== undefined && (
            <circle
              cx={(ring.cx + ring.r * Math.cos(rad(ring.dot))).toFixed(1)}
              cy={(ring.cy + ring.r * Math.sin(rad(ring.dot))).toFixed(1)}
              r="5"
              class="orbit-dot"
            />
          )}
        </g>
      ))
    }
  </g>
</svg>

<style>
  .orbits {
    display: block;
    width: 100%;
    height: auto;
    color: var(--c-art);
  }
  .orbit-dot {
    fill: #8584ad;
  }
</style>
