---
/**
 * 9. Accent service card inside its staircase track (see Services.astro). The track is the
 * sticky card's containing block; the 3D flip-in is [data-enter="flip"] in effects.css; the line
 * drawing is ServiceArt. The whole card links to the service on the services page.
 */
import type { CollectionEntry } from "astro:content";
import ServiceArt from "./ServiceArt.astro";

interface Props {
  service: CollectionEntry<"services">;
  /** Track geometry as CSS variables, set by Services.astro. */
  style?: string;
}
const { service, style } = Astro.props;
const { title, tags, art } = service.data;
---

<li class="svc-track" style={style}>
  <div class="svc-card" data-enter="flip">
    <h3 class="svc-title">
      <a href={`/services/#${service.id}`} class="svc-link">{title}</a>
    </h3>
    <p class="svc-tags">{tags}</p>
    <ServiceArt kind={art} class="svc-art" />
  </div>
</li>

<style>
  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 250px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-text);
  }
  .svc-title {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
  }
  .svc-tags {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
  }
  .svc-card :global(.svc-art) {
    margin-top: auto;
    width: 252px;
    max-width: 100%;
    max-height: 100px;
  }
  .svc-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .svc-link:focus-visible {
    outline: none;
  }
  .svc-link:focus-visible::after {
    outline: 2px solid var(--c-ink);
    outline-offset: 4px;
  }

  /* Staircase tracks: 2 columns on tablets, 3 from 900px. */
  @media (min-width: 751px) {
    .svc-track {
      position: absolute;
      left: calc(var(--c2) * (100% + 24px) / 2);
      top: var(--t2);
      bottom: var(--b2);
      width: calc((100% - 24px) / 2);
    }
    .svc-card {
      position: sticky;
      top: var(--st2);
      height: 270px;
    }
  }
  @media (min-width: 900px) {
    .svc-track {
      left: calc(var(--c3) * (100% + 24px) / 3);
      top: var(--t3);
      bottom: var(--b3);
      width: calc((100% - 48px) / 3);
    }
    .svc-card {
      top: var(--st3);
    }
  }
</style>
