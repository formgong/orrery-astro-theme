---
/**
 * 9. Accent service card. The 3D entrance is ".svc-card" in src/styles/effects.css; the line
 * drawing is ServiceArt. The whole card links to the service on the services page.
 */
import type { CollectionEntry } from "astro:content";
import ServiceArt from "./ServiceArt.astro";

interface Props {
  service: CollectionEntry<"services">;
}
const { service } = Astro.props;
const { title, tags, art } = service.data;
---

<li class="svc-card">
  <div class="svc-face">
    <h3 class="text-2xl font-normal tracking-tight">
      <a href={`/services/#${service.id}`} class="svc-link">{title}</a>
    </h3>
    <p class="mt-3 text-[1.0625rem] leading-relaxed">{tags}</p>
    <ServiceArt kind={art} class="mt-auto pt-8" />
  </div>
</li>

<style>
  .svc-face {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 19rem;
    padding: 1.75rem 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-text);
    transition: transform 0.35s var(--ease-out);
  }
  .svc-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .svc-link:focus-visible {
    outline: none;
  }
  .svc-link:focus-visible::after {
    outline: 2px solid var(--c-ink);
    outline-offset: 4px;
  }
  .svc-face:hover {
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-face:hover {
      transform: none;
    }
  }
</style>
