---
/** Top of an inner page: two-tone title (grey, then the *key words* in the accent), lead and rule. */
import { highlightParts } from "../lib/highlight";

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="container-x pt-16 pb-6 sm:pt-24 lg:pt-28">
  <h1 class="h-display load-in max-w-4xl">{highlightParts(title).map((p) => <span class={p.hl ? "hl" : "dim"}>{p.text}</span>)}</h1>
  {lead && <p class="load-in mt-8 max-w-2xl text-xl leading-relaxed" style="--d:1">{lead}</p>}
  <span class="rule load-in mt-10" style="--d:2" aria-hidden="true"></span>
  <slot />
</header>
