---
/**
 * The mark (a ring with an orbit and one accent planet) plus the business name as a two-line
 * wordmark: SITE.shortName on top, the rest of SITE.name underneath. Replace freely.
 */
import { SITE } from "../config";

interface Props {
  class?: string;
}
const rest = SITE.name.replace(SITE.shortName, "").trim();
---

<span class:list={["logo inline-flex items-center gap-3", Astro.props.class]}>
  <svg viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true" class="size-9 shrink-0 lg:size-10">
    <circle cx="20" cy="20" r="7" fill="var(--accent)"></circle>
    <ellipse cx="20" cy="20" rx="17.5" ry="8.5" transform="rotate(-28 20 20)" stroke="var(--c-ink)" stroke-width="1.5"></ellipse>
    <circle cx="33.2" cy="10.6" r="3" fill="var(--c-ink)"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.0625rem] font-semibold tracking-[0.16em] uppercase">{SITE.shortName}</span>
    {rest && <span class="mt-1 text-[0.6875rem] tracking-[0.32em] text-muted uppercase">{rest}<span class="text-accent">.</span></span>}
  </span>
</span>
