---
/** 10. Split section: a large paragraph and the accent button, next to a rounded picture that scales up as it scrolls in. */
import Ridgelines from "../Ridgelines.astro";
---

<section class="split" aria-label="When we say no">
  <div class="container-x split-col">
    <div class="split-pic">
      <div class="split-frame">
        <Ridgelines />
      </div>
    </div>
    <p class="t-big split-text">
      Two of our last five projects ended with a spreadsheet, not a model. If a pivot table answers your question, we say so in
      week one and bill for week one. The rest of the budget stays with you, and so does the spreadsheet. We would rather lose a
      project than sell you a model you do not need, and we put that promise in writing.
    </p>
    <a href="/contact/#enquiry" class="btn btn-primary split-btn">Book a call</a>
  </div>
</section>

<style>
  .split {
    padding-block: 48px;
  }
  .split-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .split-pic {
    width: 100%;
    height: 49.87vw;
  }
  .split-frame {
    height: 100%;
    overflow: clip;
    border-radius: var(--radius-media);
    background: var(--c-surface);
  }
  .split-frame :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split-text {
    width: 90%;
    margin: 24px 0 0 5%;
    font-size: min(4.948827vw, 38px);
  }
  .split-btn {
    margin: 25px 0 0 5%;
  }
  /* Desktop: picture on the right half (588 × 780 at 1440), text and button in the left half. */
  @media (min-width: 1001px) {
    .split {
      padding-block: 96px 240px;
    }
    .split-col {
      position: relative;
      min-height: 780px;
      padding-top: 96px;
    }
    .split-pic {
      position: absolute;
      top: 0;
      right: 0;
      width: 49%;
      height: 780px;
    }
    .split-text {
      width: 49%;
      margin: 0;
      font-size: 38px;
    }
    .split-btn {
      margin: 24px 0 0;
    }
  }
</style>
