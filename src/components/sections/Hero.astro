---
/**
 * 2. Hero: two-line heading, lead, accent rule, counters (3), and the moving network on the right
 * (canvas). On wide screens the hero stays put (sticky) while the next block slides up over it,
 * which is what clips the network away as you scroll (4). Entrance on load: line 1 tilts in,
 * line 2 is wiped in from the left, then the lead and counters fade in and count up.
 * The heading is SITE.tagline-free on purpose: edit the two lines below.
 */
import { SITE } from "../../config";

const lines = ["Answers from", "your own data"];

/** Counters step up like the reference: about one tick every 100 ms (400 ms for tiny numbers). */
const ticks = (n: number) => (n <= 5 ? { n, ms: 400 } : n <= 25 ? { n, ms: 100 } : { n: Math.ceil(n / (n <= 100 ? 5 : 10)), ms: 100 });
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true">
    <canvas class="net-in" data-scene="plexus"></canvas>
  </div>
  <div class="hero-col">
    <h1 id="hero-title" class="h-display hero-title">
      <span class="h1-line tilt-in">{lines[0]}</span>
      <span class="h1-line wipe-in">{lines[1]}<span class="hl">.</span></span>
    </h1>
    <div class="hero-lead fade-in">
      <p class="lead">The record so far, in four numbers:</p>
      <span class="rule" aria-hidden="true"></span>
      <ul class="stats">
        {
          SITE.stats.map((s) => {
            const t = ticks(s.value);
            return (
              <li>
                <span class="sr-only">{`${s.value}${s.suffix ?? ""} ${s.label.replace("|", " ")}`}</span>
                <span
                  class="count stat-num"
                  aria-hidden="true"
                  style={`--to:${s.value};--ticks:${t.n};--tick:${t.ms}ms`}
                  data-suffix={s.suffix ?? ""}
                />
                <span class="stat-label" aria-hidden="true">
                  {s.label.split("|").map((part, k) => (k ? [<br />, part] : part))}
                </span>
              </li>
            );
          })
        }
      </ul>
      {SITE.statsNote && <p class="stats-note">{SITE.statsNote}</p>}
    </div>
  </div>
</section>

<style>
  /* Phone layout (the reference at 375px): sizes scale with the screen width. */
  .hero {
    position: relative;
    height: 100vh;
    overflow-x: clip;
  }
  /* The network is the background of the whole hero (owner's call, 2026-10-08): edge to edge,
     full height, faded under the heading and lead on the left and towards the bottom edge. */
  .hero-net {
    position: absolute;
    inset: 0;
    -webkit-mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-net canvas {
    display: block;
    width: 100%;
    height: 100%;
    color: #ffffff;
  }
  .hero-col {
    position: relative;
    width: 90%;
    height: 100%;
    margin-inline: auto;
    pointer-events: none;
  }
  .hero-col a {
    pointer-events: auto;
  }
  .hero-title {
    position: absolute;
    top: 147px;
    left: 0;
    color: var(--c-white);
  }
  .h1-line {
    display: block;
    white-space: nowrap;
  }
  /* The reference's second line sits 5px (0.07em) lower: its period is set in a taller fallback font. */
  .h1-line + .h1-line {
    margin-top: 0.07em;
  }
  .hero-lead {
    position: absolute;
    left: 2.4vw;
    top: calc(100% - 238px);
  }
  .rule {
    margin-top: 24.5px;
  }
  .stats {
    display: flex;
    gap: 6.4vw;
    margin-top: 24px;
  }
  .stat-num {
    display: block;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    display: block;
    margin-top: 12.8px;
    font-size: 2.871307vw;
    line-height: 1.6;
    color: var(--c-white);
  }
  .stats-note {
    margin-top: 6px;
    font-size: 11px;
    color: var(--c-muted);
  }

  /* Desktop (the reference at 1440 × 727): the column starts 12px left of the page column; the
     lead block is anchored to the bottom of the screen; the network fills the right 65%. */
  @media (min-width: 751px) {
    .hero-col {
      width: min(1200px, 100% - 64px);
    }
    .hero-title {
      top: 172px;
      left: -12px;
    }
    .hero-lead {
      left: -12px;
      top: calc(100% - 307px);
    }
    .rule {
      margin-top: 48px;
    }
    .stats {
      gap: 48px;
      margin-top: 48px;
    }
    .stat-label {
      margin-top: 11px;
      font-size: 16px;
    }
    .stats-note {
      margin-top: 4px;
      font-size: 12px;
    }
  }
</style>
