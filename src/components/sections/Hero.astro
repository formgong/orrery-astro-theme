---
/**
 * 2. Hero: light display heading, lead, accent rule, counters (3), and the rotating plexus on the
 * right (canvas). Content fades in on load; the network is clipped away as you scroll (4).
 */
import { SITE } from "../../config";
---

<section class="hero relative isolate overflow-x-clip" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true">
    <canvas class="load-fade" data-scene="plexus"></canvas>
  </div>
  <div class="container-x relative grid min-h-[calc(100svh-var(--header-h))] content-center pt-12 pb-20 lg:pt-6">
    <div class="max-w-xl">
      <h1 id="hero-title" class="h-display load-in">Answers from your own data<span class="hl">.</span></h1>
      <p class="load-in mt-12 max-w-md text-xl leading-relaxed" style="--d:1">
        We forecast demand, set prices and run experiments for companies of 20 to 500 people that have data but no team to read
        it. The record so far:
      </p>
      <span class="rule load-in mt-10" style="--d:2" aria-hidden="true"></span>
      <ul class="load-in mt-10 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4" style="--d:3">
        {
          SITE.stats.map((s, i) => (
            <li>
              <span class="sr-only">{`${s.value}${s.suffix ?? ""} ${s.label}`}</span>
              <span class="count stat-num" aria-hidden="true" style={`--to:${s.value};--d:${i}`} data-suffix={s.suffix ?? ""} />
              <span class="mt-3 block text-[0.95rem] leading-snug" aria-hidden="true">
                {s.label}
              </span>
            </li>
          ))
        }
      </ul>
      {SITE.statsNote && <p class="load-in mt-8 text-sm text-muted" style="--d:4">{SITE.statsNote}</p>}
    </div>
  </div>
</section>

<style>
  .hero-net {
    position: absolute;
    z-index: -1;
    inset: 0 -30% 35% 20%;
    opacity: 0.7;
  }
  .hero-net canvas {
    width: 100%;
    height: 100%;
    color: #cfcfdc;
  }
  @media (min-width: 1024px) {
    .hero-net {
      inset: 0 -6% 0 38%;
      opacity: 1;
    }
  }
  .stat-num {
    display: block;
    font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
