---
/**
 * 11. Process: an accent panel that slides in from the left edge of the screen as it scrolls in,
 * next to turning orbits that stay in place (sticky). Each step = dot + title + paragraph; when a
 * step reaches the screen its dot opens, its title tilts in and its paragraph is wiped up into
 * view ([data-enter] in effects.css). Edit the steps below.
 */
import Orbits from "../Orbits.astro";

const steps = [
  {
    title: "Diagnosis first",
    body: "Two weeks with your data and the people who use the numbers every week. You get a ten-page memo: what the data can answer, what it cannot, and three options, each with a price.",
  },
  {
    title: "A single owner",
    body: "Each project answers one business question, agreed in writing, with one named person on your side who decides. Any change of scope goes through that person and gets a new price before work goes on.",
  },
  {
    title: "Your own tools",
    body: "Models run in your own warehouse, or as a plain Python script on a server you already own. There is no platform to license, no fee per seat, and no login that stops working on the day our contract with you comes to an end, or after.",
  },
  {
    title: "Handover & review",
    body: "In the last week your analyst reruns everything while we watch and answer questions. Ninety days later we come back for a full day, at no charge, to check that the numbers still hold up in your hands and in your tools.",
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="process-panel">
    <h2 id="process-title" class="sr-only">How a project runs</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-dot" data-enter="dot" aria-hidden="true" />
            <h3 class="step-title" data-enter="tilt">
              {step.title}
            </h3>
            <p class="step-body" data-enter="rise">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="process-side" aria-hidden="true">
    <div class="process-orbits" data-follow="500">
      <Orbits variant="rings" class="process-rings" />
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    display: flex;
    overflow-x: clip;
  }
  .process-panel {
    flex: none;
    width: 65%;
    padding: 48px 24px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent);
    color: var(--accent-text);
  }
  .steps {
    display: grid;
    gap: 24px;
  }
  .step-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
  }
  .step-title {
    margin-top: 12px;
    font-size: 5.94728vw;
    font-weight: 700;
    line-height: 1.3;
  }
  .step-body {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
  }
  .process-side {
    flex: 1;
    min-width: 0;
  }
  .process-orbits {
    position: sticky;
    top: 144px;
    margin-top: 98px;
    height: 133px;
  }
  .process-orbits :global(.process-rings) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 751px) {
    .process-panel {
      padding: 50vh 0 144px;
    }
    .steps {
      width: 450px;
      max-width: calc(100% - 48px);
      margin-inline: auto;
      gap: 96px;
    }
    .step-dot {
      width: 24px;
      height: 24px;
    }
    .step-title {
      margin-top: 24px;
      font-size: 38px;
    }
    .step-body {
      margin-top: 24.6px;
      font-size: 24px;
    }
    .process-orbits {
      top: 20vh;
      margin-block: 20vh;
      height: 60vh;
    }
  }
</style>
