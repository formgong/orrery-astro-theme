---
/**
 * 8. Two-tone heading that fills on scroll, and 9. the service cards.
 *
 * Wide screens: the cards start as a staircase (each one 300px below the one before), and as you
 * scroll each card pulls up and locks into its place in the grid (position: sticky), row 1 at
 * 144px from the top of the screen, row 2 under it. Every card sits in its own "track"; all tracks
 * end together, so the finished grid scrolls away as one block the moment the last card locks.
 * Each card also flips in (3D) the first time it reaches the screen. Phones get a plain stack.
 */
import { getCollection } from "astro:content";
import FillLines from "../FillLines.astro";
import ServiceCard from "../ServiceCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

/** Staircase geometry for `cols` columns: track top, sticky top and track bottom for card k. */
const STEP = 300; // px between consecutive cards before they lock
const ROW = 294; // card height (270) + gap (24)
const place = (k: number, cols: number) => {
  const r = Math.floor(k / cols);
  const rows = Math.ceil(services.length / cols);
  return { c: k % cols, t: STEP * k + (ROW - 6) * r, st: 144 + ROW * r, b: (rows - 1 - r) * ROW };
};
const height = (cols: number) => place(services.length - 1, cols).t + 270;
---

<section class="services overflow-x-clip" aria-labelledby="services-title">
  <div class="container-x">
    <FillLines as="h2" id="services-title" class="h-section svc-heading" lines={["Our *services*"]} ranges={[[25, 70]]} />
    <p class="lead svc-lead">Six kinds of work. Each one starts with a written scope and a fixed price.</p>
    <span class="rule svc-rule" aria-hidden="true"></span>
    <ul class="svc-grid" style={`--h3:${height(3)}px;--h2:${height(2)}px`}>
      {
        services.map((service, k) => {
          const a = place(k, 3);
          const b = place(k, 2);
          return (
            <ServiceCard
              service={service}
              style={`--c3:${a.c};--t3:${a.t}px;--st3:${a.st}px;--b3:${a.b}px;--c2:${b.c};--t2:${b.t}px;--st2:${b.st}px;--b2:${b.b}px`}
            />
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: 48px;
  }
  .svc-lead {
    width: 78%;
  }
  .svc-rule {
    margin-top: 24px;
  }
  .svc-grid {
    display: grid;
    gap: 24px;
    margin-top: 48px;
  }
  @media (min-width: 751px) {
    .services {
      padding-block: 144px;
    }
    .svc-lead {
      width: 360px;
    }
    .svc-rule {
      margin-top: 48px;
    }
    .svc-grid {
      position: relative;
      display: block;
      height: var(--h2);
      margin-top: 148px;
    }
  }
  @media (min-width: 900px) {
    .svc-grid {
      height: var(--h3);
    }
  }
</style>
