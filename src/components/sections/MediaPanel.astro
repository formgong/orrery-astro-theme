---
/**
 * 7. Large rounded panel that scales up from 90% as it scrolls in; the quote over it (not inside
 * it, so it does not scale) flips in when it reaches the screen. The moving picture is a canvas
 * of drifting lines (no video, no photo).
 */
---

<section class="media-section" aria-label="How we work">
  <figure class="container-x media-col">
    <div class="media" aria-hidden="true">
      <canvas class="media-canvas" data-scene="flow"></canvas>
      <div class="media-shade"></div>
    </div>
    <blockquote class="media-quote" data-enter="flip">
      <p>“Every number we send comes with the query that produced it<span class="hl">.</span>”</p>
    </blockquote>
  </figure>
</section>

<style>
  .media-section {
    height: 80vh;
  }
  .media-col {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
  }
  .media {
    position: absolute;
    inset: 0;
    overflow: clip;
    border-radius: var(--radius-media);
    background: var(--c-surface);
  }
  .media-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #c9c9d8;
  }
  .media-shade {
    position: absolute;
    inset: 0;
    background: rgb(4 3 25 / 0.45);
  }
  .media-quote {
    position: relative;
    width: 80vw;
    font-size: min(6.083733vw, 62px);
    line-height: 1;
    text-align: center;
    color: var(--c-white);
  }
  @media (min-width: 751px) {
    .media-section {
      height: 100vh;
      padding-block: 10vh;
    }
    .media-quote {
      width: min(1000px, 100% - 64px);
    }
  }
</style>
