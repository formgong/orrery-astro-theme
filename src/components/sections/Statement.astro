---
/**
 * 5. Statement that fills line by line on scroll, and 6. the turning orbits beside a paragraph.
 * On wide screens this block slides up over the sticky hero (see .hero-wrap in index.astro).
 */
import FillLines from "../FillLines.astro";
import Orbits from "../Orbits.astro";
---

<section class="statement" aria-label="What we do">
  <div class="container-x statement-col">
    <FillLines
      class="h-statement statement-text"
      lines={["We turn your own *records*", "into *forecasts* and *prices*", "your team can *check*."]}
    />
    <Orbits class="statement-orbits" follow={100} />
    <p class="t-big statement-para">
      Most clients already have the data: sales exports, a CRM, a stock system and some spreadsheets. We clean it once, model it in
      SQL and Python, and hand the code to your team.
    </p>
  </div>
</section>

<style>
  /* Phones and tablets: one column in the page flow (the offsets reproduce the reference at 375px). */
  .statement {
    position: relative;
    z-index: 1;
    padding-block: 48px 48.7px;
    background: var(--c-bg);
  }
  .statement-col {
    position: relative;
    height: 100%;
  }
  .statement-col :global(.statement-text .fl + .fl) {
    margin-top: 0.037em;
  }
  .statement-para {
    margin-top: 47.3px;
    line-height: 1.3;
  }
  .statement :global(.statement-orbits) {
    display: none;
  }
  /* Desktop (the reference at 1440 × 727): a 1089px block; orbits left, paragraph in the right half. */
  @media (min-width: 1001px) {
    .statement {
      height: 1089px;
      padding-block: 0;
    }
    .statement-col :global(.statement-text) {
      position: absolute;
      top: 288px;
      left: 0;
      right: 0;
    }
    .statement-col :global(.statement-text .fl + .fl) {
      margin-top: 0;
    }
    .statement :global(.statement-orbits) {
      display: block;
      position: absolute;
      top: 534px;
      left: -90px;
      width: 480px;
      height: 471px;
    }
    .statement-para {
      position: absolute;
      top: 630px;
      left: 50%;
      right: 0;
      margin: 0;
    }
  }
</style>
