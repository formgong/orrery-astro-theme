---
/**
 * 8. Two-tone section heading: the first word(s) in grey, the *key word* in the accent, a short
 * lead and a thin accent rule. Example: title="Our *services*".
 */
import { highlightParts } from "../lib/highlight";

interface Props {
  title: string;
  lead?: string;
  align?: "left" | "center";
  id?: string;
  class?: string;
  as?: "h1" | "h2";
}
const { title, lead, align = "left", id, class: className, as: Tag = "h2" } = Astro.props;
const parts = highlightParts(title);
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center", className]}>
  <Tag id={id} class="h-section">{parts.map((p) => <span class={p.hl ? "hl" : "dim"}>{p.text}</span>)}</Tag>
  {lead && <p class="lead mt-5 max-w-xl text-ink">{lead}</p>}
  <span class:list={["rule mt-10", align === "center" && "mx-auto"]} aria-hidden="true"></span>
  <slot />
</div>
