---
import { ICONS, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  /** Accessible label. Without it the icon is decorative and hidden from screen readers. */
  label?: string;
  size?: number;
}

const { name, class: className, label, size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["icon", className]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONS[name]}
/>
