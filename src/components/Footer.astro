---
/** 13. Footer over an animated 3D field of dots (canvas, src/scripts/scenes.ts). */
import { SITE } from "../config";

const { address } = SITE;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <canvas class="footer-wave" data-scene="wave" aria-hidden="true"></canvas>
  <span class="footer-rule" aria-hidden="true"></span>
  <div class="container-x footer-grid">
    <div class="f-touch">
      <p class="f-big">get in touch<span class="text-accent">.</span></p>
      <a href={SITE.cta.href} class="btn btn-primary f-btn">{SITE.cta.label}</a>
      <address class="f-address">
        {address.street}<br />
        {address.city}, {address.region} {address.postalCode}
      </address>
    </div>

    <div class="f-col f-enquiries">
      <h2 class="f-head">enquiries</h2>
      <ul class="f-list">
        <li><a href={`mailto:${SITE.email}`} class="f-link">{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone.tel}`} class="f-link">{SITE.phone.display}</a></li>
      </ul>
    </div>

    <nav aria-labelledby="footer-links" class="f-col f-links">
      <h2 id="footer-links" class="f-head">links</h2>
      <ul class="f-list">
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="f-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="f-legal">
      <p>&copy; {year} {SITE.name}. A made-up business.</p>
      <p class="f-small">Orrery theme for Astro. Forms by <a href="https://formgong.com" class="underline underline-offset-4">Formgong</a>.</p>
    </div>
    <ul class="f-social">
      {
        SITE.social.map((s) => (
          <li>
            <a href={s.href} class="f-small" rel="noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .footer-wave {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: #8582e0;
  }
  .footer-rule {
    position: absolute;
    top: 0;
    left: 5%;
    right: 0;
    height: 1px;
    background: var(--c-line);
  }
  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr;
    padding-block: 49px 53px;
    font-size: 16px;
    line-height: 1.6;
  }
  .f-touch {
    grid-column: 1 / -1;
  }
  .f-big {
    font-size: 26px;
    line-height: 1.3;
    color: var(--c-muted);
  }
  .f-btn {
    margin-top: 26px;
  }
  .f-address {
    margin-top: 24px;
    font-style: normal;
    color: var(--c-ink);
  }
  .f-col {
    margin-top: 24px;
  }
  .f-head {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-muted);
  }
  .f-list {
    display: grid;
    gap: 12px;
    margin-top: 23px;
  }
  .f-link {
    color: var(--c-white);
    border-radius: 0.375rem;
    transition: color 0.2s;
  }
  .f-link:hover,
  .f-small:hover {
    color: var(--accent);
  }
  .f-legal {
    grid-column: 1 / -1;
    order: 2;
    margin-top: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--c-ink);
  }
  .f-small {
    font-size: 14px;
    color: var(--c-muted);
  }
  .f-social {
    grid-column: 1 / -1;
    display: grid;
    gap: 24px;
    margin-block: 47px 24px;
    font-size: 14px;
    line-height: 1;
  }
  @media (min-width: 1001px) {
    .footer-rule {
      left: max(16px, (100% - 1296px) / 2);
    }
    .footer-grid {
      grid-template-columns: 63.42% 25.58% 1fr;
      padding-block: 97px 100px;
    }
    .f-touch {
      grid-column: auto;
    }
    .f-col {
      margin-top: 0;
    }
    .f-legal {
      grid-column: 1 / 3;
      order: 0;
      margin-top: 47px;
    }
    .f-social {
      grid-column: 3;
      margin: 47px 0 0 -4px;
      gap: 14px;
    }
  }
</style>
