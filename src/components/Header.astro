---
/**
 * 1. Fixed header: logo, three links in the middle, the accent button on the right and a 1px
 * divider that runs from the content edge to the right edge of the screen.
 */
import { SITE } from "../config";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <Logo />
    </a>

    <nav aria-label="Main" class="main-nav">
      <ul>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={SITE.cta.href} class="btn btn-primary header-cta">{SITE.cta.label}</a>
    <button type="button" popovertarget="mobile-nav" class="menu-btn" aria-label="Open menu">
      <Icon name="menu" />
    </button>
    <span class="header-rule" aria-hidden="true"></span>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <div class="header-inner">
      <a href="/" class="header-logo"><Logo /></a>
      <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" class="menu-btn" aria-label="Close menu">
        <Icon name="x" />
      </button>
    </div>
    <nav aria-label="Mobile" class="container-x pt-6">
      <ul class="border-t border-line">
        <li><a href="/" class="mobile-link" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="mobile-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={SITE.cta.href} class="btn btn-primary btn-lg mt-10 w-full">{SITE.cta.label}</a>
      <p class="mt-6 text-sm text-muted">
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">{SITE.email}</a> · {SITE.phone.display}
      </p>
    </nav>
  </div>
</header>

<script>
  // Close the menu when a link inside it is followed (matters for same-page anchors).
  const menu = document.getElementById("mobile-nav");
  menu?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.hidePopover();
  });
</script>

<style>
  /* Measured on the reference: 90px tall; logo, links and button on a 1296px row (1200px column
     plus 48px each side); a 1px line from the row's left edge to the right edge of the screen. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    overflow-x: clip;
    background: var(--c-bg);
    view-transition-name: site-header;
  }
  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 90%;
    height: var(--header-h);
    margin-inline: auto;
  }
  .header-logo {
    display: flex;
    align-items: center;
    width: 200px;
    height: 52px;
  }
  .header-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: calc((100% - 100vw) / 2);
    height: 1px;
    background: var(--c-line);
  }
  .main-nav,
  .header-cta {
    display: none;
  }
  .main-nav ul {
    display: flex;
    gap: 48px;
  }
  .nav-link {
    display: block;
    padding-block: 7px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-white);
    transition: color 0.2s;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--accent);
  }
  .header-cta {
    width: 150px;
    height: 60px;
  }
  /* Phones: a lime round menu button, as on the reference. */
  .menu-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-text);
  }
  .menu-btn :global(.icon) {
    width: 22px;
    height: 22px;
  }
  @media (min-width: 1001px) {
    .header-inner {
      width: min(1296px, 100% - 32px);
    }
    /* The links start 114px left of the centre (as measured), so they line up whatever their length. */
    .main-nav {
      display: block;
      position: absolute;
      left: calc(50% - 114px);
    }
    .header-cta {
      display: inline-flex;
    }
    .site-header > .header-inner > .menu-btn {
      display: none;
    }
  }
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    overflow-y: auto;
    background: var(--c-bg);
    color: var(--c-ink);
  }
  .mobile-link {
    display: block;
    padding: 1.125rem 0.25rem;
    border-bottom: 1px solid var(--c-line);
    font-size: 2rem;
    font-weight: 250;
    letter-spacing: -0.02em;
  }
  .mobile-link[aria-current="page"] {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.3s var(--ease-out),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
    }
    .mobile-nav:not(:popover-open) {
      opacity: 0;
      transform: translateY(-12px);
    }
    @starting-style {
      .mobile-nav:popover-open {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }
</style>
