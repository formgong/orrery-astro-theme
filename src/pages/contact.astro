---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

const { address } = SITE;
const next = [
  "One of us reads your message and replies within one working day.",
  "We book a 30-minute call to hear the decision and look at what data you have.",
  "If data can help, you get a written price for the two-week diagnostic. If it can't, we say so on the call.",
];
---

<BaseLayout
  title="Contact"
  description={`Tell ${SITE.name} about the decision you are working on. We reply within one working day. ${SITE.phone.display}, ${SITE.email}.`}
>
  <PageHeader title="Tell us about the *decision*" lead="A few lines are enough: what you need to decide, by when, and where your data lives today." />

  <section class="pt-10 pb-24 lg:pb-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div id="enquiry" class="scroll-mt-28 lg:col-span-7">
        <h2 class="sr-only">Contact form</h2>
        <ContactForm />
      </div>
      <aside class="lg:col-span-5" aria-labelledby="details-title">
        <h2 id="details-title" class="text-2xl font-light">Other ways to reach us</h2>
        <ul class="mt-6 space-y-4 text-lg">
          <li>
            <a href={`mailto:${SITE.email}`} class="contact-link"><Icon name="mail" class="text-accent" />{SITE.email}</a>
          </li>
          <li>
            <a href={`tel:${SITE.phone.tel}`} class="contact-link"><Icon name="phone" class="text-accent" />{SITE.phone.display}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="map-pin" class="mt-1 shrink-0 text-accent" />
            <span>{address.street}<br />{address.city}, {address.region} {address.postalCode}</span>
          </li>
        </ul>
        <p class="mt-6 text-muted">{SITE.areaServed}.</p>

        <h2 class="mt-12 text-2xl font-light">Office hours</h2>
        <dl class="mt-5 space-y-2">
          {
            SITE.hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-line pb-2">
                <dt class="text-muted">{h.label}</dt>
                <dd>{h.opens && h.closes ? `${h.opens} – ${h.closes}` : "Closed"}</dd>
              </div>
            ))
          }
        </dl>
        {SITE.hoursNote && <p class="mt-4 text-sm text-muted">{SITE.hoursNote}</p>}

        <h2 class="mt-12 text-2xl font-light">What happens next</h2>
        <ol class="mt-6 space-y-5">
          {
            next.map((step, i) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-sm text-accent-text">{i + 1}</span>
                <span class="text-muted">{step}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.375rem;
    transition: color 0.2s;
  }
  .contact-link:hover {
    color: var(--accent);
  }
</style>
