---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

// Visitors land here after the plain HTML form (no JavaScript) was accepted by Formgong.
const steps = [
  "One of us reads your message today or on the next working day.",
  "We reply by email with two or three times for a 30-minute call.",
  "On the call we tell you whether data can help, and what the diagnostic would cost.",
];
---

<BaseLayout title="Thank you" description="Your message has been received." noindex>
  <section class="container-x py-20 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto grid size-20 place-items-center rounded-full bg-accent text-accent-text">
        <Icon name="check" size={40} />
      </span>
      <h1 class="h-display mt-10"><span class="dim">We have</span> <span class="hl">your message</span></h1>
      <p class="lead mt-6">What happens next:</p>
    </div>
    <ol class="stagger mx-auto mt-12 grid max-w-2xl gap-4">
      {
        steps.map((step, i) => (
          <li class="card flex items-center gap-5 p-5 sm:p-6" style={`--i:${i}`}>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-accent-text">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
    <div class="mx-auto mt-12 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-secondary btn-lg">Back to the home page</a>
      <a href={`tel:${SITE.phone.tel}`} class="btn btn-primary btn-lg"><Icon name="phone" /> {SITE.phone.display}</a>
    </div>
  </section>
</BaseLayout>
