---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Orbits from "../components/Orbits.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

// Roles, not names: replace them with your own people.
const team = [
  { role: "Lead statistician", note: "Forecasting and experiments. Twelve years in grocery supply chains before Quillmoor." },
  { role: "Pricing specialist", note: "Price response models and discount rules. Previously set prices for a freight carrier." },
  { role: "Analytics engineer", note: "SQL, dbt and warehouses. Builds the checks and jobs you keep after we leave." },
  { role: "Reporting lead", note: "Metric definitions and dashboards. Writes the glossary your finance lead signs." },
  { role: "Office manager", note: "Scheduling, contracts and invoices. The person who answers the phone." },
];
const terms = [
  { title: "Fixed price per phase", text: "You get a price for the diagnostic, then a price for the project. If the scope changes, the price changes in writing before we continue." },
  { title: "The diagnostic is credited", text: "The two-week diagnostic costs $4,800. If you go ahead with the project within three months, we take it off the project price." },
  { title: "No retainers", text: "We invoice monthly against the agreed phases. When the work is done, the invoices stop." },
];
const turnDown = [
  "Projects without one person on your side who owns the result",
  "Licensing a platform you would have to keep paying for",
  "Strategy decks with no numbers behind them",
  "Work for two competitors in the same market at the same time",
];
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a five-person data and strategy consultancy founded in 2012. Who you work with, how we charge, and the work we turn down.`}
>
  <PageHeader
    title="Five people who *show their working*"
    lead="Quillmoor started in 2012, when two statisticians left a grocery chain and a freight company to do the same work for firms that could not hire a data team of their own."
  />

  <section class="section" aria-labelledby="team-title">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading id="team-title" title="Who you *work with*" lead="Everyone on your project does the work. There are no juniors learning on your budget." />
        <Orbits class="mt-16 hidden max-w-xs lg:block" />
      </div>
      <ul class="stagger divide-y divide-line border-y border-line lg:col-span-7">
        {
          team.map((m, i) => (
            <li class="grid gap-2 py-7 sm:grid-cols-[14rem_1fr] sm:gap-8" style={`--i:${i}`}>
              <h3 class="text-xl">{m.role}</h3>
              <p class="text-muted">{m.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="terms-title">
    <div class="container-x">
      <SectionHeading id="terms-title" title="How we *charge*" />
      <ul class="stagger mt-14 grid gap-6 md:grid-cols-3">
        {
          terms.map((t, i) => (
            <li class="card p-7" style={`--i:${i}`}>
              <h3 class="text-xl">{t.title}</h3>
              <p class="mt-3 text-muted">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-36" aria-labelledby="no-title">
    <div class="container-x">
      <div class="reveal rounded-3xl bg-accent p-8 text-accent-text sm:p-12 lg:p-16">
        <h2 id="no-title" class="h-section">Work we turn down</h2>
        <ul class="mt-10 grid gap-4 text-lg sm:grid-cols-2">
          {
            turnDown.map((item) => (
              <li class="flex gap-3">
                <Icon name="x" size={22} class="mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a href={SITE.cta.href} class="btn btn-dark btn-lg mt-12">{SITE.cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
