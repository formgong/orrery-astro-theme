---
import "@fontsource/questrial/400.css";
import "../styles/global.css";
import { SITE } from "../config";
import Head, { type Props as HeadProps } from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = HeadProps;
const props = Astro.props;
const hex = SITE.theme.accent.replace("#", "");
const accentHalf = `rgba(${[0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(", ")}, 0.5)`;
---

<!doctype html>
<html lang={SITE.lang} style={`--accent:${SITE.theme.accent};--accent-half:${accentHalf};--accent-text:${SITE.theme.accentText}`}>
  <head>
    <Head {...props} />
  </head>
  <body class="bg-bg font-sans text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="pt-(--header-h) outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/scenes";
      import "../scripts/enter";
      import "../scripts/follow";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--accent-text);
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
</style>
